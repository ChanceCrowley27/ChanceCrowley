x_input=float(input("what is your first number \n"))
y_input=float(input("whats your second number \n"))

def add(x, y):
    print(x+y)    

def subtract(x, y):
    print(x - y)

def multiply(x, y):
    print(x*y)

def divide(x, y):
    print(x/y)
    
add(x_input, y_input)
subtract(x_input, y_input)
multiply(x_input, y_input)
divide(x_input, y_input)