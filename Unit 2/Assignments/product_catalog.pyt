def product(name,description,price,quantity,weight):
     print("your product is "+name+" it is "+description+" it costs "+str(price)+" there are "+ str(quantity)+" in stock "+" and it weights "+str(weight))

product_name=input("whats the name of your product \n>")
product_description=input("whats a description of your product \n>")
product_price=float(input("how much does your product cost \n>"))
quantity_in_stock=int(input("how much product is in stock \n>"))
product_weight=float(input("what does this product weight \n>"))

product(product_name,product_description,product_price,quantity_in_stock,product_weight)

