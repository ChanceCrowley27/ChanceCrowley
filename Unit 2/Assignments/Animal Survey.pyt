animal=input("what is your favorite animal \n")

why_do_you_like_them=input("why do you like them \n") # could be something easy or something complex

live=input("where do they live \n")

interesting=input("what is interesting about them \n")  # interesting facts meant to be real facts

diet=input("what do they eat \n")

sound=input("what sound to they make \n") #sounds not supported take best guess

sleep=input("how do they sleep \n")

print("---------------------------------------------------------------------")

print("your favorite animal is "+animal +"  you like them because  "+why_do_you_like_them+ " they live in "+ live+ "one interesting fact about them is "+ interesting + " their diet consists of "+diet+ "they make a sound like "+sound+ " and they sleep in "+sleep) #meant to put periods suposed to be multi sentence